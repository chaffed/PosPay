# Copy to .env and adjust. All vars are prefixed POSPAY_ (see config.py).

# SQLite (zero setup, default):
POSPAY_DATABASE_URL=sqlite:///./pospay.db
# Postgres:
# POSPAY_DATABASE_URL=postgresql+psycopg://pospay:pospay@localhost:5432/pospay
# MSSQL (requires the Microsoft ODBC Driver installed at the OS level):
# POSPAY_DATABASE_URL=mssql+pyodbc://pospay:pospay@localhost:1433/pospay?driver=ODBC+Driver+18+for+SQL+Server

# Required for any real deployment (see README.md's "Signing keys" section):
POSPAY_ENVIRONMENT=production
# Generate all three key pairs with: python scripts/generate_keys.py --output-dir keys
POSPAY_JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
POSPAY_JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
POSPAY_FILE_SIGNING_PRIVATE_KEY_PATH=keys/file_signing_private.pem
POSPAY_FILE_SIGNING_PUBLIC_KEY_PATH=keys/file_signing_public.pem
POSPAY_AUDIT_LOG_SIGNING_PRIVATE_KEY_PATH=keys/audit_log_signing_private.pem
POSPAY_AUDIT_LOG_SIGNING_PUBLIC_KEY_PATH=keys/audit_log_signing_public.pem
# A random string (not a key pair — this encrypts stored SSO client secrets, it doesn't sign anything):
POSPAY_SSO_ENCRYPTION_KEY=change-me-in-production-to-a-random-32-byte-value
# Local testing only: lets SSO connections use http:// and private/localhost identity
# providers (e.g. Keycloak on http://localhost:8080). Refused in production.
# POSPAY_OIDC_ALLOW_PRIVATE_HOSTS=true

POSPAY_OCR_PROVIDER=tesseract

# WebAuthn/FIDO2 (optional second factor, see auth/webauthn_service.py). rp_id must be a
# domain the browser accepts as the current page's registrable domain (no scheme/port);
# origin must be the exact scheme+host(+port) the frontend is served from. Defaults below
# are localhost-only — set both explicitly for any real deployment or every registered
# key will fail to verify against the real origin.
# POSPAY_WEBAUTHN_RP_ID=your-domain.com
# POSPAY_WEBAUTHN_RP_NAME=PosPay
# POSPAY_WEBAUTHN_ORIGIN=https://your-domain.com

# Public demo organization (see README.md's "Demo tenant" section):
# POSPAY_DEMO_TENANT_ENABLED=true
# POSPAY_DEMO_TENANT_PASSWORD=a-password-you-intend-to-publish
# POSPAY_DEMO_TENANT_RESET_INTERVAL_MINUTES=60
